{erl_opts, [debug_info]}.

{deps, [
    {jiffy, {path, "local_deps/jiffy"}},
    {hackney, {path, "local_deps/hackney"}},
    {idna, {path, "local_deps/idna"}},
    {certifi, {path, "local_deps/certifi"}},
    {metrics, {path, "local_deps/metrics"}},
    {mimerl, {path, "local_deps/mimerl"}},
    {parse_trans, {path, "local_deps/parse_trans"}},
    {ssl_verify_fun, {path, "local_deps/ssl_verify_fun"}},
    {unicode_util_compat, {path, "local_deps/unicode_util_compat"}}
]}.

{shell, [
    {apps, [ims_dc_sip]}
]}.

{relx, [
    {release, {ims_dc_sip, "1.0.0"}, [ims_dc_sip]},
    {mode, prod},
    {sys_config, "config/sys.config"},
    {vm_args_src, "config/vm.args.src"}
]}.
