{
  "scenarios": [
    {
      "name": "Scenario 1: Whiteboard Draw & FunCalling & Exit Mini-App (2003 calling 2004)",
      "caller": {
        "username": "2003",
        "password": "password2003"
      },
      "callee": {
        "username": "2004",
        "password": "password2004"
      },
      "steps": [
        {
          "action": "wait_register",
          "timeout_ms": 15000
        },
        {
          "action": "dial",
          "timeout_ms": 30000
        },
        {
          "action": "http_get_bdc",
          "payload": "/",
          "delay_ms": 1000
        },
        {
          "action": "request_app",
          "payload": "sketch-sync-app",
          "delay_ms": 7000
        },
        {
          "action": "wait_webrtc_connect",
          "stream_id": 1000,
          "timeout_ms": 30000
        },
        {
          "action": "send_data",
          "stream_id": 1000,
          "payload": "{\"type\":\"draw\",\"action\":\"start\",\"x\":150,\"y\":300,\"color\":\"#ff0000\"}",
          "delay_ms": 500
        },
        {
          "action": "send_data",
          "stream_id": 1000,
          "payload": "{\"type\":\"draw\",\"action\":\"move\",\"x\":170,\"y\":310,\"color\":\"#ff0000\"}",
          "delay_ms": 500
        },
        {
          "action": "send_data",
          "stream_id": 1001,
          "payload": "{\"service\":\"fun-calling\",\"action\":\"send_emoji\",\"type\":\"heart\"}",
          "delay_ms": 1000
        },
        {
          "action": "assert_rtp",
          "delay_ms": 3000
        },
        {
          "action": "close_app",
          "payload": "sketch-sync-app",
          "delay_ms": 2000
        },
        {
          "action": "hangup",
          "payload": "caller",
          "delay_ms": 2000
        }
      ]
    },
