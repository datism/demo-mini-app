FROM postgres:14-alpine

RUN apk update && apk add --no-cache python3 py3-pip py3-setuptools py3-wheel jq curl bash

# Install patroni with kubernetes DCS support
RUN pip3 install --break-system-packages patroni[kubernetes] psycopg2-binary

# Create patroni config directory
RUN mkdir -p /etc/patroni && chown -R postgres:postgres /etc/patroni

COPY patroni.yml /etc/patroni/patroni.yml
COPY setup_db.sh /etc/patroni/setup_db.sh
RUN chmod +x /etc/patroni/setup_db.sh
RUN chown -R postgres:postgres /etc/patroni

USER postgres

EXPOSE 8008 5432

ENTRYPOINT ["patroni", "/etc/patroni/patroni.yml"]
