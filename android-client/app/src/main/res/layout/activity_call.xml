<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Layer 1: Remote Video Background -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000">
        <SurfaceView
            android:id="@+id/remote_video_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- Layer 2: Gradient Background Placeholder (covers video until connected) -->
    <View
        android:id="@+id/view_background_placeholder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gradient_call_bg2" />

    <!-- Layer 3: Main Call UI Overlay -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top Bar: compact row (avatar, name, status · timer) over a soft gradient -->
        <LinearLayout
            android:id="@+id/layout_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/gradient_top_bar"
            android:paddingTop="44dp"
            android:paddingBottom="24dp"
            android:paddingHorizontal="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/tv_top_avatar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_call_avatar"
                android:gravity="center"
                android:text="W"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_remote_user"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="My Wife ❤️❤️❤️"
                    android:textColor="#FFFFFFFF"
                    android:textSize="17sp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_call_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dialing..."
                        android:textColor="#CCFFFFFF"
                        android:textSize="13sp"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tv_call_timer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" · 00:00"
                        android:textColor="#CCFFFFFF"
                        android:textSize="13sp"
                        android:fontFeatureSettings="tnum"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Calling state: large pulsing avatar, hidden once video or a mini-app shows -->
        <LinearLayout
            android:id="@+id/layout_middle_details"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="56dp"
            app:layout_constraintTop_toBottomOf="@id/layout_top_bar"
            app:layout_constraintBottom_toTopOf="@id/layout_bottom_controls"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <FrameLayout
                android:layout_width="128dp"
                android:layout_height="128dp">

                <View
                    android:id="@+id/view_avatar_pulse"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_call_avatar_ring" />

                <TextView
                    android:id="@+id/tv_big_avatar"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_call_avatar"
                    android:gravity="center"
                    android:text="W"
                    android:textColor="#FFFFFFFF"
                    android:textSize="38sp"
                    android:textStyle="bold" />

                <!-- Certified caller: green check on the avatar -->
                <TextView
                    android:id="@+id/tv_verified_check"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_verified_check"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="#FFFFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_big_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="My Wife ❤️❤️❤️"
                android:textColor="#FFFFFFFF"
                android:textSize="24sp"
                android:fontFamily="sans-serif-medium" />

            <!-- Certified caller details (number, badge, "verified by the carrier") -->
            <TextView
                android:id="@+id/tv_big_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#CCFFFFFF"
                android:textSize="15sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_verified_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_verified_pill"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                android:text="✓  Đã xác thực"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_verified_by"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Xác thực bởi nhà mạng"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Call controls: frosted pill with Mute, Speaker, Hold and End -->
        <LinearLayout
            android:id="@+id/layout_bottom_controls"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="28dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_call_controls_pill"
            android:elevation="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageButton
                android:id="@+id/btn_mute"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/bg_call_btn"
                android:backgroundTint="#29FFFFFF"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mute"
                android:contentDescription="Tắt tiếng" />

            <ImageButton
                android:id="@+id/btn_speaker_circle"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/bg_call_btn"
                android:backgroundTint="#29FFFFFF"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_speaker"
                android:contentDescription="Loa ngoài" />

            <ImageButton
                android:id="@+id/btn_keypad_circle"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/bg_call_btn"
                android:backgroundTint="#29FFFFFF"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_hold"
                android:contentDescription="Giữ cuộc gọi" />

            <ImageButton
                android:id="@+id/btn_end_call"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/bg_call_btn_end"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_phone_decline"
                android:contentDescription="Kết thúc cuộc gọi" />
        </LinearLayout>

        <!-- Ringing Call controls: Dual Swipe Circles (Slide to Answer / Reject) -->
        <com.demo.imsdc.widget.SlideToAnswerView
            android:id="@+id/slide_to_answer_view"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginBottom="32dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Local Video Preview (floating on top left) -->
        <org.webrtc.SurfaceViewRenderer
            android:id="@+id/local_video_view"
            android:layout_width="90dp"
            android:layout_height="125dp"
            android:layout_margin="16dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/layout_top_bar"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- WebView overlay: fits the area above bottom controls -->
        <WebView
            android:id="@+id/webview_miniapp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="#00000000"
            android:visibility="invisible"
            app:layout_constraintTop_toBottomOf="@id/layout_top_bar"
            app:layout_constraintBottom_toTopOf="@id/guideline_webview_bottom"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_webview_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.82" />

        <!-- My camera folded into a button (tap the camera tile); a tap opens the tile again. -->
        <ImageButton
            android:id="@+id/btn_camera_restore"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_margin="16dp"
            android:background="@drawable/bg_call_btn"
            android:backgroundTint="#8C000000"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_camera_tile"
            android:elevation="8dp"
            android:contentDescription="Hiện camera của bạn"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/layout_top_bar"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Full-screen mode: the only call UI left on screen. A tap shows the call buttons for a few seconds. -->
        <LinearLayout
            android:id="@+id/layout_call_pill"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:background="@drawable/bg_call_pill_fullscreen"
            android:elevation="8dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Hiện nút cuộc gọi"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/dot_call_live" />

            <TextView
                android:id="@+id/tv_pill_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="00:00"
                android:textColor="#FFFFFFFF"
                android:textSize="12.5sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- Exit Mini-App / Return to Menu: white pill with an apps icon, top right -->
        <Button
            android:id="@+id/btn_exit_miniapp"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="16dp"
            android:paddingVertical="0dp"
            android:drawableStart="@drawable/ic_menu_grid"
            android:drawablePadding="8dp"
            android:gravity="center"
            android:text="Menu"
            android:contentDescription="Quay về menu"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textColor="#FF111111"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/bg_call_menu_pill"
            app:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:elevation="6dp"
            android:visibility="gone"
            android:layout_marginEnd="14dp"
            android:layout_marginTop="42dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
