<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Layer 1: Remote Video Background -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000">
        <SurfaceView
            android:id="@+id/remote_video_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- Layer 2: Gradient Background Placeholder (covers video until connected) -->
    <View
        android:id="@+id/view_background_placeholder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gradient_call_bg2" />

    <!-- Layer 3: Main Call UI Overlay -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top Bar (Name, Location, Status, Timer) - Always visible -->
        <LinearLayout
            android:id="@+id/layout_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="60dp"
            android:paddingBottom="20dp"
            android:paddingHorizontal="20dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/tv_remote_user"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Wife ❤️❤️❤️"
                android:textColor="#FFFFFFFF"
                android:textSize="32sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tv_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0358 197 864 Vietnam"
                android:textColor="#CCFFFFFF"
                android:textSize="16sp"
                android:layout_marginTop="8dp" />


            <TextView
                android:id="@+id/tv_call_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dialing..."
                android:textColor="#CCFFFFFF"
                android:textSize="16sp"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tv_call_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#CCFFFFFF"
                android:textSize="16sp"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Middle Call details (6 Action Buttons) - hidden when webview is visible -->
        <LinearLayout
            android:id="@+id/layout_middle_details"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:gravity="bottom|center_horizontal"
            android:paddingHorizontal="24dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintTop_toBottomOf="@id/layout_top_bar"
            app:layout_constraintBottom_toTopOf="@id/layout_bottom_controls"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- 2. Six circular action buttons in 2x3 Grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <!-- Grid Row 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="24dp">

                    <!-- Record -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:padding="14dp"
                            android:src="@drawable/ic_record"
                            android:background="@drawable/circle_call_button_bg" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Record"
                            android:textColor="#FFFFFFFF"
                            android:textSize="12sp"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>

                    <!-- Hold -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:padding="14dp"
                            android:src="@drawable/ic_hold"
                            android:background="@drawable/circle_call_button_bg" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hold"
                            android:textColor="#FFFFFFFF"
                            android:textSize="12sp"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>

                    <!-- Add call -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:padding="14dp"
                            android:src="@drawable/ic_add_call"
                            android:background="@drawable/circle_call_button_bg" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Add call"
                            android:textColor="#FFFFFFFF"
                            android:textSize="12sp"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Grid Row 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <!-- Notes -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:padding="14dp"
                            android:src="@drawable/ic_notes"
                            android:background="@drawable/circle_call_button_bg" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Notes"
                            android:textColor="#FFFFFFFF"
                            android:textSize="12sp"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>

                    <!-- Mute -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageView
                            android:id="@+id/btn_mute"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:padding="14dp"
                            android:src="@drawable/ic_mute"
                            android:background="@drawable/circle_call_button_bg"
                            android:clickable="true"
                            android:focusable="true"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mute"
                            android:textColor="#FFFFFFFF"
                            android:textSize="12sp"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>

                    <!-- Contacts -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:padding="14dp"
                            android:src="@drawable/ic_contacts"
                            android:tint="#FFFFFFFF"
                            android:background="@drawable/circle_call_button_bg" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Contacts"
                            android:textColor="#FFFFFFFF"
                            android:textSize="12sp"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <!-- Active Call controls bottom row -->
        <LinearLayout
            android:id="@+id/layout_bottom_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:paddingBottom="60dp"
            android:background="@android:color/transparent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <!-- Keypad circular button -->
            <ImageButton
                android:id="@+id/btn_keypad_circle"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:background="@drawable/circle_blue_button_bg"
                android:src="@drawable/ic_keypad"
                android:contentDescription="Keypad" />

            <!-- End Call circular button -->
            <ImageButton
                android:id="@+id/btn_end_call"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginHorizontal="24dp"
                android:background="@drawable/circle_red_button_bg"
                android:src="@drawable/ic_phone_decline"
                android:contentDescription="Kết thúc cuộc gọi"
                android:elevation="4dp" />

            <!-- Speaker circular button -->
            <ImageButton
                android:id="@+id/btn_speaker_circle"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:background="@drawable/circle_blue_button_bg"
                android:src="@drawable/ic_speaker"
                android:contentDescription="Loa ngoài" />

        </LinearLayout>

        <!-- Ringing Call controls: Dual Swipe Circles (Slide to Answer / Reject) -->
        <com.demo.imsdc.widget.SlideToAnswerView
            android:id="@+id/slide_to_answer_view"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginBottom="32dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Local Video Preview (floating on top left) -->
        <org.webrtc.SurfaceViewRenderer
            android:id="@+id/local_video_view"
            android:layout_width="90dp"
            android:layout_height="125dp"
            android:layout_margin="16dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/layout_top_bar"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- WebView overlay: fits the area above bottom controls -->
        <WebView
            android:id="@+id/webview_miniapp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="#00000000"
            android:visibility="invisible"
            app:layout_constraintTop_toBottomOf="@id/layout_top_bar"
            app:layout_constraintBottom_toTopOf="@id/guideline_webview_bottom"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_webview_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.82" />

        <!-- Exit Mini-App / Return to Menu Button -->
        <Button
            android:id="@+id/btn_exit_miniapp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quay lại Menu"
            android:textSize="12sp"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#E64A19"
            android:visibility="gone"
            android:layout_margin="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
