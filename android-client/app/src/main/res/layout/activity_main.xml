<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_main.xml — Màn hình Login / Setup & Samsung OneUI Dialer
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ─── SCREEN 1: LOGIN & SETUP (Dark Theme) ─────────────────────── -->
    <ScrollView
        android:id="@+id/layout_setup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF0D0D1A"
        android:fillViewport="true"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📡"
                android:textSize="64sp"
                android:layout_marginTop="40dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IMS DC Demo"
                android:textColor="#FFFFFFFF"
                android:textSize="28sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5G New Calling · Data Channel PoC"
                android:textColor="#99FFFFFF"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tv_local_ip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Local IP: detecting..."
                android:textColor="#66FFFFFF"
                android:textSize="11sp"
                android:layout_marginTop="4dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                app:cardBackgroundColor="#1A1A2E"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SIP Server (Erlang)"
                        android:textColor="#AAFFFFFF"
                        android:textSize="12sp"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/et_sip_server"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="192.168.1.100"
                        android:inputType="textUri"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#55FFFFFF"
                        android:backgroundTint="#557C83FF"
                        android:padding="12dp"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your Username"
                        android:textColor="#AAFFFFFF"
                        android:textSize="12sp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/et_username"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="userA"
                        android:inputType="text"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#55FFFFFF"
                        android:backgroundTint="#557C83FF"
                        android:padding="12dp"
                        android:textSize="16sp" />

                    <TextView
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Call User (Default)"
                        android:textColor="#AAFFFFFF"
                        android:textSize="12sp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:visibility="gone"
                        android:id="@+id/et_remote_user"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="userB"
                        android:inputType="text"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#55FFFFFF"
                        android:backgroundTint="#557C83FF"
                        android:padding="12dp"
                        android:textSize="16sp" />

                    <TextView
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Local IP (Change to Host IP for Emulator)"
                        android:textColor="#AAFFFFFF"
                        android:textSize="12sp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:visibility="gone"
                        android:id="@+id/et_local_ip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="192.168.1.2"
                        android:inputType="text"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#55FFFFFF"
                        android:backgroundTint="#557C83FF"
                        android:padding="12dp"
                        android:textSize="16sp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chưa đăng ký"
                android:textColor="#AAFFFFFF"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginTop="16dp"
                android:padding="12dp"
                android:background="@drawable/status_bg" />

            <Button
                android:id="@+id/btn_register"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="📡 REGISTER"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:backgroundTint="#FF7C83FF"
                android:textColor="#FFFFFF"
                android:layout_marginTop="16dp"
                android:stateListAnimator="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3GPP TS 23.228 Annex AC · TS 26.114"
                android:textColor="#33FFFFFF"
                android:textSize="10sp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp" />

        </LinearLayout>
    </ScrollView>

    <!-- ─── SCREEN 2: HOME (One UI Phone style: Bàn phím · Gần đây · Danh bạ) ─── -->
    <RelativeLayout
        android:id="@+id/layout_dialer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFF7F7F9"
        android:visibility="gone">

        <!-- Gần đây / Danh bạ: big title that scrolls away with the list -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_recent_calls"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:paddingBottom="104dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp">

                <LinearLayout
                    android:id="@+id/top_header"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:orientation="vertical"
                    android:gravity="center">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_badge_5g"
                            android:paddingHorizontal="7dp"
                            android:paddingVertical="1dp"
                            android:text="5G"
                            android:textColor="#FFFFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="New Calling"
                            android:textColor="#FF111111"
                            android:textSize="30sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tv_header_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="#FF6E6E73"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Toolbar icons under the title, right-aligned -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:orientation="horizontal"
                    android:gravity="end|center_vertical">
                    <ImageView
                        android:id="@+id/btn_more_menu"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="8dp"
                        android:src="@drawable/ic_more_vert"
                        app:tint="#FF111111"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Thêm tùy chọn"
                        android:background="?android:attr/selectableItemBackgroundBorderless" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_recent_calls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Bàn phím: full-screen keypad -->
        <LinearLayout
            android:id="@+id/layout_dialpad_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="28dp"
            android:paddingBottom="104dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/btn_more_menu_keypad"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="end"
                android:layout_marginTop="16dp"
                android:padding="8dp"
                android:src="@drawable/ic_more_vert"
                app:tint="#FF111111"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Thêm tùy chọn"
                android:background="?android:attr/selectableItemBackgroundBorderless" />

            <!-- Number area fills the space above the keys -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/tv_dial_digits"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textSize="34sp"
                    android:textColor="#FF111111"
                    android:maxLines="1"
                    android:ellipsize="start" />
                <TextView
                    android:id="@+id/btn_add_to_contacts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:padding="6dp"
                    android:text="Thêm vào danh bạ"
                    android:textColor="#FF16A34A"
                    android:textSize="15sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:visibility="invisible" />
            </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">
                    <LinearLayout
                        android:id="@+id/key_1"
                        android:layout_width="0dp"
                        android:layout_height="76dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?android:attr/selectableItemBackgroundBorderless">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1" android:textColor="#FF111111" android:textSize="34sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="oo" android:textColor="#FF6E6E73" android:textSize="12sp" android:minHeight="16dp" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/key_2"
                        android:layout_width="0dp"
                        android:layout_height="76dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?android:attr/selectableItemBackgroundBorderless">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2" android:textColor="#FF111111" android:textSize="34sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ABC" android:textColor="#FF6E6E73" android:textSize="12sp" android:minHeight="16dp" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/key_3"
                        android:layout_width="0dp"
                        android:layout_height="76dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?android:attr/selectableItemBackgroundBorderless">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3" android:textColor="#FF111111" android:textSize="34sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DEF" android:textColor="#FF6E6E73" android:textSize="12sp" android:minHeight="16dp" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">
                    <LinearLayout
                        android:id="@+id/key_4"
                        android:layout_width="0dp"
                        android:layout_height="76dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?android:attr/selectableItemBackgroundBorderless">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4" android:textColor="#FF111111" android:textSize="34sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GHI" android:textColor="#FF6E6E73" android:textSize="12sp" android:minHeight="16dp" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/key_5"
                        android:layout_width="0dp"
                        android:layout_height="76dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?android:attr/selectableItemBackgroundBorderless">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5" android:textColor="#FF111111" android:textSize="34sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="JKL" android:textColor="#FF6E6E73" android:textSize="12sp" android:minHeight="16dp" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/key_6"
                        android:layout_width="0dp"
                        android:layout_height="76dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?android:attr/selectableItemBackgroundBorderless">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="6" android:textColor="#FF111111" android:textSize="34sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MNO" android:textColor="#FF6E6E73" android:textSize="12sp" android:minHeight="16dp" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">
                    <LinearLayout
                        android:id="@+id/key_7"
                        android:layout_width="0dp"
                        android:layout_height="76dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?android:attr/selectableItemBackgroundBorderless">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="7" android:textColor="#FF111111" android:textSize="34sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PQRS" android:textColor="#FF6E6E73" android:textSize="12sp" android:minHeight="16dp" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/key_8"
                        android:layout_width="0dp"
                        android:layout_height="76dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?android:attr/selectableItemBackgroundBorderless">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="8" android:textColor="#FF111111" android:textSize="34sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TUV" android:textColor="#FF6E6E73" android:textSize="12sp" android:minHeight="16dp" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/key_9"
                        android:layout_width="0dp"
                        android:layout_height="76dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?android:attr/selectableItemBackgroundBorderless">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="9" android:textColor="#FF111111" android:textSize="34sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="WXYZ" android:textColor="#FF6E6E73" android:textSize="12sp" android:minHeight="16dp" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">
                    <LinearLayout
                        android:id="@+id/key_star"
                        android:layout_width="0dp"
                        android:layout_height="76dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?android:attr/selectableItemBackgroundBorderless">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="*" android:textColor="#FF111111" android:textSize="34sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FF6E6E73" android:textSize="12sp" android:minHeight="16dp" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/key_0"
                        android:layout_width="0dp"
                        android:layout_height="76dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?android:attr/selectableItemBackgroundBorderless">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#FF111111" android:textSize="34sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+" android:textColor="#FF6E6E73" android:textSize="12sp" android:minHeight="16dp" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/key_pound"
                        android:layout_width="0dp"
                        android:layout_height="76dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?android:attr/selectableItemBackgroundBorderless">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="#" android:textColor="#FF111111" android:textSize="34sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FF6E6E73" android:textSize="12sp" android:minHeight="16dp" />
                    </LinearLayout>
                </LinearLayout>

            <!-- Call button centred, backspace to its right -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:layout_marginTop="8dp">
                <ImageButton
                    android:id="@+id/btn_dialer_call"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_centerInParent="true"
                    android:background="@drawable/circle_green_button_bg"
                    android:src="@android:drawable/ic_menu_call"
                    app:tint="#FFFFFFFF"
                    android:contentDescription="Bắt đầu cuộc gọi" />
                <ImageButton
                    android:id="@+id/btn_backspace"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="20dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_backspace"
                    app:tint="#FF6E6E73"
                    android:contentDescription="Xóa ký tự"
                    android:visibility="invisible" />
            </RelativeLayout>
        </LinearLayout>

        <!-- Floating pill navigation -->
        <LinearLayout
            android:id="@+id/bottom_nav_bar"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="24dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="4dp"
            android:background="@drawable/bg_nav_pill"
            android:elevation="8dp">
            <LinearLayout
                android:id="@+id/tab_keypad"
                android:layout_width="84dp"
                android:layout_height="56dp"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_keypad"
                    app:tint="#FF3A3A3C"
                    android:importantForAccessibility="no" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Bàn phím"
                    android:textColor="#FF3A3A3C"
                    android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/tab_phone"
                android:layout_width="84dp"
                android:layout_height="56dp"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_phone_active"
                    app:tint="#FF3A3A3C"
                    android:importantForAccessibility="no" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Gần đây"
                    android:textColor="#FF3A3A3C"
                    android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/tab_contacts"
                android:layout_width="84dp"
                android:layout_height="56dp"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_contacts"
                    app:tint="#FF3A3A3C"
                    android:importantForAccessibility="no" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Danh bạ"
                    android:textColor="#FF3A3A3C"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

    </RelativeLayout>

</FrameLayout>
