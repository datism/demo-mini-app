<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_main.xml — Màn hình Login / Setup & Samsung OneUI Dialer
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ─── SCREEN 1: LOGIN & SETUP (Dark Theme) ─────────────────────── -->
    <ScrollView
        android:id="@+id/layout_setup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF0D0D1A"
        android:fillViewport="true"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📡"
                android:textSize="64sp"
                android:layout_marginTop="40dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IMS DC Demo"
                android:textColor="#FFFFFFFF"
                android:textSize="28sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5G New Calling · Data Channel PoC"
                android:textColor="#99FFFFFF"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tv_local_ip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Local IP: detecting..."
                android:textColor="#66FFFFFF"
                android:textSize="11sp"
                android:layout_marginTop="4dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                app:cardBackgroundColor="#1A1A2E"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SIP Server (Erlang)"
                        android:textColor="#AAFFFFFF"
                        android:textSize="12sp"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/et_sip_server"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="192.168.1.100"
                        android:inputType="textUri"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#55FFFFFF"
                        android:backgroundTint="#557C83FF"
                        android:padding="12dp"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your Username"
                        android:textColor="#AAFFFFFF"
                        android:textSize="12sp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/et_username"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="userA"
                        android:inputType="text"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#55FFFFFF"
                        android:backgroundTint="#557C83FF"
                        android:padding="12dp"
                        android:textSize="16sp" />

                    <TextView
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Call User (Default)"
                        android:textColor="#AAFFFFFF"
                        android:textSize="12sp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:visibility="gone"
                        android:id="@+id/et_remote_user"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="userB"
                        android:inputType="text"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#55FFFFFF"
                        android:backgroundTint="#557C83FF"
                        android:padding="12dp"
                        android:textSize="16sp" />

                    <TextView
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Local IP (Change to Host IP for Emulator)"
                        android:textColor="#AAFFFFFF"
                        android:textSize="12sp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:visibility="gone"
                        android:id="@+id/et_local_ip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="192.168.1.2"
                        android:inputType="text"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#55FFFFFF"
                        android:backgroundTint="#557C83FF"
                        android:padding="12dp"
                        android:textSize="16sp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chưa đăng ký"
                android:textColor="#AAFFFFFF"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginTop="16dp"
                android:padding="12dp"
                android:background="@drawable/status_bg" />

            <Button
                android:id="@+id/btn_register"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="📡 REGISTER"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:backgroundTint="#FF7C83FF"
                android:textColor="#FFFFFF"
                android:layout_marginTop="16dp"
                android:stateListAnimator="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3GPP TS 23.228 Annex AC · TS 26.114"
                android:textColor="#33FFFFFF"
                android:textSize="10sp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp" />

        </LinearLayout>
    </ScrollView>

    <!-- ─── SCREEN 2: SAMSUNG ONEUI DIALER KEYPAD (Light Theme) ────────── -->
    <RelativeLayout
        android:id="@+id/layout_dialer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFFFF"
        android:visibility="gone">

        <!-- Top Header -->
        <RelativeLayout
            android:id="@+id/top_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="6dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phone"
                android:textColor="#FF111111"
                android:textSize="32sp"
                android:fontFamily="sans-serif-black" />
            <ImageView
                android:id="@+id/btn_more_menu"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_more_vert"
                android:tint="#FF111111"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless" />
        </RelativeLayout>

        <!-- Bottom Navigation Tabs Bar -->
        <LinearLayout
            android:id="@+id/bottom_nav_bar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_alignParentBottom="true"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="#FFFFFFFF"
            android:paddingHorizontal="20dp"
            android:layout_marginBottom="4dp">

            <!-- Phone Tab -->
            <LinearLayout
                android:id="@+id/tab_phone"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_phone_active" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Phone"
                    android:textColor="#FF22C55E"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- Contacts Tab -->
            <LinearLayout
                android:id="@+id/tab_contacts"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_contacts" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Contacts"
                    android:textColor="#FF8E8E93"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Favourites Tab -->
            <LinearLayout
                android:id="@+id/tab_favourites"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_favourites" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Favourites"
                    android:textColor="#FF8E8E93"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Recent Calls List (Vertical Scrollable, takes all space above dialpad or nav bar) -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_recent_calls"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/top_header"
            android:layout_above="@id/layout_dialpad_panel"
            android:scrollbars="vertical"
            android:paddingHorizontal="20dp"
            android:fillViewport="true">
            <LinearLayout
                android:id="@+id/layout_recent_calls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="4dp" />
        </androidx.core.widget.NestedScrollView>

        <!-- Floating Action Button: Mở lại Dialpad khi đang thu gọn -->
        <androidx.cardview.widget.CardView
            android:id="@+id/fab_show_dialpad"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_above="@id/bottom_nav_bar"
            android:layout_alignParentRight="true"
            android:layout_marginRight="24dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="30dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#FF22C55E"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_keypad"
                app:tint="#FFFFFFFF"
                android:contentDescription="Mở bàn phím quay số" />
        </androidx.cardview.widget.CardView>

        <!-- Keypad Panel (Collapsible) -->
        <LinearLayout
            android:id="@+id/layout_dialpad_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/bottom_nav_bar"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:background="#FFFFFFFF">

            <!-- Number Display -->
            <TextView
                android:id="@+id/tv_dial_digits"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:gravity="center"
                android:textSize="36sp"
                android:textColor="#FF000000"
                android:fontFamily="sans-serif-medium"
                android:hint=""
                android:maxLines="1"
                android:scrollHorizontally="true"
                android:ellipsize="start"
                android:layout_marginBottom="4dp" />

            <!-- Keypad Rows -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="8dp"
                android:layout_marginBottom="10dp">

                <!-- Row 1 (1 2 3) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="10dp">
                    <LinearLayout
                        android:id="@+id/key_1"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/dialer_key_bg"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginHorizontal="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1" android:textColor="#FF000000" android:textSize="24sp" android:fontFamily="sans-serif-medium" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="oo" android:textColor="#FF8E8E93" android:textSize="9sp" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/key_2"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/dialer_key_bg"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginHorizontal="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2" android:textColor="#FF000000" android:textSize="24sp" android:fontFamily="sans-serif-medium" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="A B C" android:textColor="#FF8E8E93" android:textSize="9sp" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/key_3"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/dialer_key_bg"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginHorizontal="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3" android:textColor="#FF000000" android:textSize="24sp" android:fontFamily="sans-serif-medium" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="D E F" android:textColor="#FF8E8E93" android:textSize="9sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 2 (4 5 6) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="10dp">
                    <LinearLayout
                        android:id="@+id/key_4"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/dialer_key_bg"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginHorizontal="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4" android:textColor="#FF000000" android:textSize="24sp" android:fontFamily="sans-serif-medium" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="G H I" android:textColor="#FF8E8E93" android:textSize="9sp" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/key_5"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/dialer_key_bg"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginHorizontal="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5" android:textColor="#FF000000" android:textSize="24sp" android:fontFamily="sans-serif-medium" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="J K L" android:textColor="#FF8E8E93" android:textSize="9sp" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/key_6"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/dialer_key_bg"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginHorizontal="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="6" android:textColor="#FF000000" android:textSize="24sp" android:fontFamily="sans-serif-medium" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="M N O" android:textColor="#FF8E8E93" android:textSize="9sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 3 (7 8 9) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="10dp">
                    <LinearLayout
                        android:id="@+id/key_7"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/dialer_key_bg"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginHorizontal="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="7" android:textColor="#FF000000" android:textSize="24sp" android:fontFamily="sans-serif-medium" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="P Q R S" android:textColor="#FF8E8E93" android:textSize="9sp" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/key_8"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/dialer_key_bg"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginHorizontal="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="8" android:textColor="#FF000000" android:textSize="24sp" android:fontFamily="sans-serif-medium" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="T U V" android:textColor="#FF8E8E93" android:textSize="9sp" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/key_9"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/dialer_key_bg"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginHorizontal="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="9" android:textColor="#FF000000" android:textSize="24sp" android:fontFamily="sans-serif-medium" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="W X Y Z" android:textColor="#FF8E8E93" android:textSize="9sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 4 (* 0 #) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">
                    <LinearLayout
                        android:id="@+id/key_star"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/dialer_key_bg"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginHorizontal="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="*" android:textColor="#FF000000" android:textSize="26sp" android:fontFamily="sans-serif-medium" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="(P)" android:textColor="#FF8E8E93" android:textSize="9sp" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/key_0"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/dialer_key_bg"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginHorizontal="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#FF000000" android:textSize="24sp" android:fontFamily="sans-serif-medium" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+" android:textColor="#FF8E8E93" android:textSize="10sp" android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/key_pound"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/dialer_key_bg"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginHorizontal="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="#" android:textColor="#FF000000" android:textSize="24sp" android:fontFamily="sans-serif-medium" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="(W)" android:textColor="#FF8E8E93" android:textSize="9sp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <!-- Bottom Action Row -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginBottom="2dp">

                <!-- Dialer Pad Hide (Left side) -->
                <ImageButton
                    android:id="@+id/btn_logout"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="28dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_keypad"
                    app:tint="#FF8E8E93"
                    android:contentDescription="Thu gọn bàn phím" />

                <!-- Green Dial Button (Center) -->
                <ImageButton
                    android:id="@+id/btn_dialer_call"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_centerInParent="true"
                    android:background="@drawable/circle_green_button_bg"
                    android:src="@android:drawable/ic_menu_call"
                    app:tint="#FFFFFFFF"
                    android:contentDescription="Bắt đầu cuộc gọi"
                    android:elevation="4dp" />

                <!-- Backspace Button (Right side) -->
                <ImageButton
                    android:id="@+id/btn_backspace"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:layout_marginRight="28dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_backspace"
                    app:tint="#FF8E8E93"
                    android:contentDescription="Xóa ký tự" />

            </RelativeLayout>

        </LinearLayout>

    </RelativeLayout>

</FrameLayout>
